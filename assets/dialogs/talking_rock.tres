dialogs = {
"PEN_PAL_DIALOG_14": {
"default": "Hey! Someone... omg it has been soo long since I have seen anyone these days!",
"en": ""
},
"PEN_PAL_DIALOG_15": {
"default": "Oh hello!",
"en": ""
},
"PEN_PAL_DIALOG_16": {
"default": "Oh, perhaps you have a message for you?",
"en": ""
},
"PEN_PAL_DIALOG_17": {
"default": "Oh, thats ok, I have a message for you, could you deliver it?",
"en": ""
},
"PEN_PAL_DIALOG_18": {
"default": "Omg, rock I haven't heard from them in a while, its nice to know they still are around! Its getting hard to send messages lately! Actually could you deliver this note back to they? It would be really nice!",
"en": ""
},
"PEN_PAL_DIALOG_19": {
"default": "So did you send the message yet?",
"en": ""
},
"PEN_PAL_DIALOG_20": {
"default": "Work In Progress!",
"en": ""
},
"PEN_PAL_OPT2_1": {
"default": "Rock said..."
},
"PEN_PAL_OPT2_2": {
"default": "No..."
},
"PEN_PAL_OPT3_1": {
"default": "No,,,"
},
"PEN_PAL_OPT3_2": {
"default": "Yeah"
},
"TALKING_ROCK_DIALOG_1": {
"default": "Hello?",
"en": ""
},
"TALKING_ROCK_DIALOG_10": {
"default": "What is the button?",
"en": ""
},
"TALKING_ROCK_DIALOG_11": {
"default": "The button? Ah that is a pressure switch, if it detects something heavy upon it, it will active the connecting gate! When moving if you move into an object you push it! Isn't that neat.",
"en": ""
},
"TALKING_ROCK_DIALOG_12": {
"default": "Um, I accidentally shove you to the wall... and I'm too weak to pull you out from that wall...",
"en": ""
},
"TALKING_ROCK_DIALOG_13": {
"default": "[wave]...[/wave] No worries you can press 'Z' it undo actions and regrets.",
"en": ""
},
"TALKING_ROCK_DIALOG_2": {
"default": "[pulse]The rock give no response[/pulse]",
"en": ""
},
"TALKING_ROCK_DIALOG_21": {
"default": "Ah! Thank you so much, its so nice to hear from them again!",
"en": ""
},
"TALKING_ROCK_DIALOG_22": {
"default": "Work In Progress",
"en": ""
},
"TALKING_ROCK_DIALOG_23": {
"default": "You already delivered that, come talke to me with new information or if you get stuck!",
"en": ""
},
"TALKING_ROCK_DIALOG_3": {
"default": "Hello??",
"en": ""
},
"TALKING_ROCK_DIALOG_4": {
"default": "[shake]Zzzzzzzzzzzzzzzzzzz...[/shake]",
"en": ""
},
"TALKING_ROCK_DIALOG_5": {
"default": "...",
"en": ""
},
"TALKING_ROCK_DIALOG_6": {
"default": "Huh? Oh hey! I didn't see you there kinda dose of for a sec, sorry!",
"en": ""
},
"TALKING_ROCK_DIALOG_7": {
"default": "You do talk!",
"en": ""
},
"TALKING_ROCK_DIALOG_8": {
"default": "Of course I talk...",
"en": ""
},
"TALKING_ROCK_DIALOG_9": {
"default": "Though rocks only talk to each other usually, speaking of which could you passed this note to my penpal, their past the gate, its being a while since I've heard from them... It gets harder and harder every year!",
"en": ""
},
"TALKING_ROCK_OPT1_1": {
"default": "Talk to the rock"
},
"TALKING_ROCK_OPT1_2": {
"default": "Button?"
},
"TALKING_ROCK_OPT1_3": {
"default": "Got an Object stuck!"
},
"TALKING_ROCK_OPT1_4": {
"default": "I have better things to do"
},
"TALKING_ROCK_OPT1_5": {
"default": "I have a message for you"
}
}
